{
  "name": "@photon-ai/voice-ts",
  "version": "0.1.0",
  "description": "TypeScript SDK for Photon Spectrum Voice",
  "author": "Photon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/photon-hq/voice-ts.git"
  },
  "keywords": [
    "voice",
    "telephony",
    "grpc",
    "photon",
    "typescript"
  ],
  "type": "module",
  "exports": {
    ".": {
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "proto"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "PATH=./node_modules/.bin:$PATH buf generate",
    "build": "bun run generate && tsup",
    "dev": "tsup --watch",
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.6",
    "long": "^5.2.4",
    "nice-grpc": "^2.1.11",
    "nice-grpc-common": "^2.0.2",
    "protobufjs": "^7.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@bufbuild/buf": "^1.50.0",
    "@types/bun": "latest",
    "ts-proto": "^2.6.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "ultracite": "7.6.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
